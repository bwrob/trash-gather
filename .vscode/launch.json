{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Unit Tests (µnit)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/bin/test_runner",
      "args": ["--no-fork"],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "just: test-build",
      "stopOnEntry": false
    },
    {
      "name": "Debug Sandbox App",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/bin/main_app",
      "args": [],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "just: build",
      "stopOnEntry": false
    }
  ]
}
