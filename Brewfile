# Brewfile for trash-gather (macOS development tools)

brew "uv"              # Python environment & package manager
brew "just"            # Command runner (justfile)
brew "clang-format"    # C/C++ code formatter
brew "llvm"            # Clang, clang-tidy, lldb
brew "google-benchmark" # C++ micro-benchmarking
brew "hyperfine"       # CLI benchmarking
brew "watchexec"       # File watcher for watch mode
